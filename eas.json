{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "sahla-dev": {
      "extends": "base",
      "env": {
        "MASJID_ID": "sahla"
      }
    },
    "sahla-preview": {
      "extends": "base",
      "autoIncrement": true,
      "environment": "preview",
      "channel": "preview",
      "env": {
        "MASJID_ID": "sahla"
      }
    },
    "sahla-prod": {
      "extends": "base",
      "developmentClient": false,
      "distribution": "store",
      "env": {
        "MASJID_ID": "sahla"
      }
    },
    "mas-cnj-dev": {
      "extends": "base",
      "env": {
        "MASJID_ID": "mas-cnj"
      }
    },
    "mas-cnj-preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "MASJID_ID": "mas-cnj"
      }
    },
    "mas-cnj-prod": {
      "extends": "base",
      "developmentClient": false,
      "distribution": "store",
      "env": {
        "MASJID_ID": "mas-cnj"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
