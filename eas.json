{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "24.10.0",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "base"
    },
    "sahla-dev": {
      "extends": "base",
      "env": {
        "MASJID_ID": "sahla"
      },
      "channel": "sahla-dev"
    },
    "sahla-preview": {
      "extends": "base",
      "environment": "preview",
      "channel": "sahla-preview",
      "env": {
        "MASJID_ID": "sahla"
      }
    },
    "sahla-prod": {
      "extends": "base",
      "developmentClient": false,
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "MASJID_ID": "sahla"
      },
      "channel": "sahla-prod"
    },
    "mas-cnj-dev": {
      "extends": "base",
      "env": {
        "MASJID_ID": "mas-cnj"
      },
      "channel": "mas-cnj-dev"
    },
    "mas-cnj-preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "MASJID_ID": "mas-cnj"
      },
      "channel": "mas-cnj-preview"
    },
    "mas-cnj-prod": {
      "extends": "base",
      "developmentClient": false,
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "MASJID_ID": "mas-cnj"
      },
      "channel": "mas-cnj-prod"
    },
    "mas-brooklyn-mqb18esx-dev": {
      "extends": "base",
      "env": {
        "MASJID_ID": "mas-brooklyn-mqb18esx"
      },
      "channel": "mas-brooklyn-mqb18esx-dev"
    },
    "mas-brooklyn-mqb18esx-preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "MASJID_ID": "mas-brooklyn-mqb18esx"
      },
      "channel": "mas-brooklyn-mqb18esx-preview"
    },
    "mas-brooklyn-mqb18esx-prod": {
      "extends": "base",
      "developmentClient": false,
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "MASJID_ID": "mas-brooklyn-mqb18esx"
      },
      "channel": "mas-brooklyn-mqb18esx-prod"
    }
  },
  "submit": {
    "production": {}
  }
}
